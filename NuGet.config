<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-local NuGet configuration.

  The machine's user-level NuGet config has no package sources at all, which makes any
  restore of Microsoft.Windows.SDK.NET.Ref (needed for net8.0-windows10.0.x WinRT
  projections) fail with NU1100. Pinning the source here keeps restore deterministic for
  every agent and does not depend on a machine-level setting.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
