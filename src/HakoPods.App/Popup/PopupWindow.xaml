<Window x:Class="HakoPods.App.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="336" Height="206"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        FontFamily="{StaticResource InterFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">

    <Border x:Name="Card" CornerRadius="22" Background="#FFFFFF">
        <Border.Effect>
            <!-- Shadow is the only edge: 0.5 px ring at 5 %, 4 px lift at 6 %, 34 px ambient at 30 %. -->
            <DropShadowEffect x:Name="AmbientShadow"
                              Color="Black" BlurRadius="34" ShadowDepth="14"
                              Direction="270" Opacity="0.30" />
        </Border.Effect>

        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: product name left, status right. No device glyph. -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="ModelText"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Three equal 92 DIP columns with 12 DIP gutters. -->
            <Grid x:Name="StandardLayout" Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftColumn" Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LeftEar" Width="8" Height="8" StrokeThickness="1.2"
                                 Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="LeftLabel" Text="Left" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="LeftValue" FontSize="32" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   TextOptions.TextFormattingMode="Display" />
                        <TextBlock x:Name="LeftPercent" Text="%" FontSize="17" VerticalAlignment="Bottom"
                                   Margin="1,0,0,3" />
                        <Viewbox Width="9" Height="13" Margin="4,0,0,4" VerticalAlignment="Bottom">
                            <Path x:Name="LeftBolt" Data="M0,0 L5,0 L2.4,5 L4.6,5 L0,9.6 L1.9,4.4 L0,4.4 Z"
                                  Fill="{Binding MarkBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="Collapsed" />
                        </Viewbox>
                    </StackPanel>
                    <Grid Margin="0,12,0,0" Height="6">
                        <Border CornerRadius="3" x:Name="LeftTrack" />
                        <Border CornerRadius="3" x:Name="LeftFill" HorizontalAlignment="Left" Width="0" />
                        <Rectangle x:Name="LeftDash" RadiusX="3" RadiusY="3" Height="6" Visibility="Collapsed"
                                  StrokeThickness="1" StrokeDashArray="1.4 1.4" />
                    </Grid>
                    <TextBlock x:Name="LeftLow" Text="Low" FontSize="12" FontWeight="SemiBold"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="RightColumn" Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RightEar" Width="8" Height="8" StrokeThickness="1.2"
                                 Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="RightLabel" Text="Right" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="RightValue" FontSize="32" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   TextOptions.TextFormattingMode="Display" />
                        <TextBlock x:Name="RightPercent" Text="%" FontSize="17" VerticalAlignment="Bottom"
                                   Margin="1,0,0,3" />
                        <Viewbox Width="9" Height="13" Margin="4,0,0,4" VerticalAlignment="Bottom">
                            <Path x:Name="RightBolt" Data="M0,0 L5,0 L2.4,5 L4.6,5 L0,9.6 L1.9,4.4 L0,4.4 Z"
                                  Fill="{Binding MarkBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="Collapsed" />
                        </Viewbox>
                    </StackPanel>
                    <Grid Margin="0,12,0,0" Height="6">
                        <Border CornerRadius="3" x:Name="RightTrack" />
                        <Border CornerRadius="3" x:Name="RightFill" HorizontalAlignment="Left" Width="0" />
                        <Rectangle x:Name="RightDash" RadiusX="3" RadiusY="3" Height="6" Visibility="Collapsed"
                                  StrokeThickness="1" StrokeDashArray="1.4 1.4" />
                    </Grid>
                    <TextBlock x:Name="RightLow" Text="Low" FontSize="12" FontWeight="SemiBold"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="CaseColumn" Grid.Column="4">
                    <TextBlock x:Name="CaseLabel" Text="Case" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="CaseValue" FontSize="32" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   TextOptions.TextFormattingMode="Display" />
                        <TextBlock x:Name="CasePercent" Text="%" FontSize="17" VerticalAlignment="Bottom"
                                   Margin="1,0,0,3" />
                        <Viewbox Width="9" Height="13" Margin="4,0,0,4" VerticalAlignment="Bottom">
                            <Path x:Name="CaseBolt" Data="M0,0 L5,0 L2.4,5 L4.6,5 L0,9.6 L1.9,4.4 L0,4.4 Z"
                                  Fill="{Binding MarkBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="Collapsed" />
                        </Viewbox>
                    </StackPanel>
                    <Grid Margin="0,12,0,0" Height="6">
                        <Border CornerRadius="3" x:Name="CaseTrack" />
                        <Border CornerRadius="3" x:Name="CaseFill" HorizontalAlignment="Left" Width="0" />
                        <Rectangle x:Name="CaseDash" RadiusX="3" RadiusY="3" Height="6" Visibility="Collapsed"
                                  StrokeThickness="1" StrokeDashArray="1.4 1.4" />
                    </Grid>
                    <TextBlock x:Name="CaseLow" Text="Low" FontSize="12" FontWeight="SemiBold"
                               Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- AirPods Max: one centred value, one 190 DIP rail, no empty slots. -->
            <StackPanel x:Name="MaxLayout" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="MaxLabel" Text="Headphones" FontSize="12" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="MaxValue" FontSize="44" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               TextOptions.TextFormattingMode="Display" />
                    <TextBlock x:Name="MaxPercent" Text="%" FontSize="17" VerticalAlignment="Bottom"
                               Margin="1,0,0,7" />
                </StackPanel>
                <Grid Margin="0,12,0,0" Height="6" Width="190">
                    <Border CornerRadius="3" x:Name="MaxTrack" />
                    <Border CornerRadius="3" x:Name="MaxFill" HorizontalAlignment="Left" Width="0" />
                        <Rectangle x:Name="MaxDash" RadiusX="3" RadiusY="3" Height="6" Visibility="Collapsed"
                                  StrokeThickness="1" StrokeDashArray="1.4 1.4" />
                </Grid>
                <TextBlock x:Name="MaxLow" Text="Low" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock x:Name="FooterText" Grid.Row="2" FontSize="12" Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
