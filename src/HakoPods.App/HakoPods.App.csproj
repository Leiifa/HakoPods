<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon lives in WinForms; mixing is the cheapest way to a tray without a package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Set through the property rather than the manifest: with WinForms referenced, the SDK
         refuses manifest DPI settings (WFAC010) and applies this one at startup instead. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>HakoPods.App</RootNamespace>
    <AssemblyName>HakoPods</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HakoPods.Core\HakoPods.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Tray\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled, not assumed: Segoe UI would silently replace the type scale at runtime. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
