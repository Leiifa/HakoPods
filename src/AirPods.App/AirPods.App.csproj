<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon lives in WinForms; mixing is the cheapest way to a tray without a package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Set through the property rather than the manifest: with WinForms referenced, the SDK
         refuses manifest DPI settings (WFAC010) and applies this one at startup instead. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>AirPods.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirPods.Core\AirPods.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Tray\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
